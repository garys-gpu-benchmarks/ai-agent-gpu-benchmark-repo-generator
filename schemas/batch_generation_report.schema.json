{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amd.example/schemas/batch_generation_report.schema.json",
  "title": "Batch Generation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation_started_at",
    "generation_finished_at",
    "generation_duration_seconds",
    "prompt_file",
    "submitted_prompt_artifact",
    "requested_workloads",
    "remote_validation_ip",
    "remote_refresh_requested",
    "remote_refresh_confirmed",
    "remote_refresh_status",
    "repositories"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "generation_started_at": {"type": "string", "minLength": 1},
    "generation_finished_at": {"type": ["string", "null"]},
    "generation_duration_seconds": {"type": ["integer", "null"], "minimum": 0},
    "prompt_file": {"type": "string", "minLength": 1},
    "submitted_prompt_artifact": {"type": "string", "minLength": 1},
    "requested_workloads": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[0-9]+$"}
    },
    "remote_validation_ip": {
      "type": ["string", "null"],
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"
    },
    "remote_refresh_requested": {"type": "boolean"},
    "remote_refresh_confirmed": {"type": "boolean"},
    "remote_refresh_status": {
      "type": "string",
      "enum": ["not_requested", "validation_only", "pending", "submitted", "failed"]
    },
    "generation_successful_seconds": { "type": "integer", "minimum": 0 },
    "generation_seconds_including_failed_attempts": { "type": "integer", "minimum": 0 },
    "remote_host_preflight": { "type": "object", "description": "Remote VM probe before workload 1 (TEMPLATE_00_119). Warnings only." },
    "host_bootstrap": { "type": "object", "description": "One-time host bootstrap before workload 1, timed apart from the workloads (TEMPLATE_00_119)." },
    "host_prefetch": { "type": "object", "description": "Background Hugging Face prefetch status read at the end of the batch (TEMPLATE_00_119)." },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workload",
          "status",
          "return_code",
          "create_start_time",
          "create_end_time",
          "create_total_time"
        ],
        "properties": {
          "workload": {"type": "string", "pattern": "^[0-9]+$"},
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "abandoned", "timed_out"]
          },
          "return_code": {"type": "integer"},
          "create_start_time": {"type": "string", "minLength": 1},
          "create_end_time": {"type": "string", "minLength": 1},
          "create_total_time": {"type": "string", "minLength": 1},
          "repo_name": {"type": "string"},
          "repo_path": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
